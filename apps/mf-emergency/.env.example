# mf-emergency — Microfrontend de Emergencias
# Copiar a .env y completar con las URLs del entorno de destino.

# ── Shell ──────────────────────────────────────────────────
# URL del remoteEntry.js del shell — usada para consumir el UserContext compartido.
VITE_REMOTE_SHELL=http://localhost:10500/remoteEntry.js

# ── Triage ─────────────────────────────────────────────────
# URL del remoteEntry.js de mf-triage — mf-emergency monta el modal de Triaje
# como remote (ver src/pages/MonitorPage.tsx).
VITE_REMOTE_TRIAGE=http://localhost:10510/remoteEntry.js

# ── Historia Clínica ─────────────────────────────────────────
# URL del remoteEntry.js de mf-clinical-record — mf-emergency monta
# ClinicalRecord como remote (ruta historiacli, ver src/Emergency.tsx).
VITE_REMOTE_CLINICAL_RECORD=http://localhost:10511/assets/remoteEntry.js

# ── Gateway (API) ──────────────────────────────────────────
# URL base del API Gateway Web Emergency (puerto 10602 en local).
VITE_APIGW_CNL_WEB_EMERGENCY=http://localhost:10602

# URL base del API Gateway de catálogos transversales (Cross) — usado por
# AllergyModal para consultar catalogs/active-principles.
VITE_APIGW_CLN_CROSS=http://localhost:10601


# ── Cifrado AES-256-GCM (monitor público) ──────────────────
# Clave hex de 32 bytes para descifrar la respuesta del endpoint public.
# Obtener del equipo de backend — NO commitear el valor real.
VITE_EMERGENCY_DECRYPT_KEY=

VITE_APIGW_BS_HCE=http://localhost:10604
