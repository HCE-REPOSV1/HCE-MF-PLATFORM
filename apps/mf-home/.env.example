# mf-home — Microfrontend de Inicio / Dashboard
# Copiar a .env y completar con las URLs del entorno de destino.

# ── URL base del propio app ────────────────────────────────
# Debe coincidir con la URL pública desde la que se sirve este app.
# Vite la usa como prefijo para los assets del bundle (cross-origin asset fix).
# En desarrollo: http://localhost:10502
# En producción: http://<ip-servidor>:10502  (o la URL pública correspondiente)
VITE_BASE_URL=http://localhost:10502

# ── Shell ──────────────────────────────────────────────────
# URL del remoteEntry.js del shell — usada para consumir el UserContext compartido.
VITE_REMOTE_SHELL=http://localhost:10500/remoteEntry.js
