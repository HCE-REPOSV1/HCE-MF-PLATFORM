# mf-clinical-record — Microfrontend de Historia Clínica
# Copiar a .env y completar con las URLs del entorno de destino.

# ── Shell ──────────────────────────────────────────────────
# URL del remoteEntry.js del shell — usada para consumir el UserContext y el
# ApiClient compartidos (shell/UserContext, shell/ApiClient).
VITE_REMOTE_SHELL=http://localhost:10500/assets/remoteEntry.js

# ── Gateway (API) ──────────────────────────────────────────
# URL base del API Gateway Web Emergency (puerto 10602 en local) — expone
# encounter/* (patient-summary, historial clínico, anamnesis y examen físico).
VITE_APIGW_CNL_WEB_EMERGENCY=http://localhost:10602

# URL base del API Gateway de catálogos transversales (Cross) — usado por
# useCatalog para active-principles, companion-types, background-catalog,
# administration-routes y medication-products.
VITE_APIGW_CLN_CROSS=http://localhost:10601
