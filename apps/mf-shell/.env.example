# mf-shell — Shell / Orquestador
# Copiar a .env y completar con las URLs del entorno de destino.
# En desarrollo usar localhost; en producción usar la IP/dominio del servidor.

# ── Gateway (API) ──────────────────────────────────────────
# URL base del API Gateway (ag-pruebas-ag).
# Usada por el shell para llamadas a /auth/me, /auth/accesos, etc.
VITE_AUTH_URL=http://localhost:10401

# ── Remotes — URLs de remoteEntry.js de cada microfrontend ─
# Formato: http://<host>:<puerto>/remoteEntry.js
# El shell carga estos módulos en runtime via Module Federation.
VITE_REMOTE_AUTH=http://localhost:10501/remoteEntry.js
VITE_REMOTE_HOME=http://localhost:10502/remoteEntry.js
VITE_REMOTE_EMERGENCY=http://localhost:10503/remoteEntry.js
VITE_REMOTE_HOSPITAL=http://localhost:10504/remoteEntry.js
VITE_REMOTE_AMBULATORIO=http://localhost:10505/remoteEntry.js
VITE_REMOTE_AUDITORIA=http://localhost:10506/remoteEntry.js
