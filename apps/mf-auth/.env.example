# mf-auth — Microfrontend de Autenticación
# Copiar a .env y completar con las URLs del entorno de destino.

# mf-auth no llama al API Gateway directamente para el login — delega en
# shell/AuthService (Module Federation), por eso necesita la URL del shell.
VITE_REMOTE_SHELL=http://localhost:10500/assets/remoteEntry.js

# Para i18n (rutas públicas i18n/locales, i18n/public/...) mf-auth SÍ llama
# al API Gateway directamente — ver src/config/endpoints.ts.
VITE_APIGW_CNL_CROSS=http://localhost:10601

# Idioma a usar cuando no viene ?lang= válido en la URL (ver src/main.tsx).
# Soportados: es | en. Si se omite o es inválido, @hce/i18n-core cae a "es".
VITE_DEFAULT_LOCALE=es
